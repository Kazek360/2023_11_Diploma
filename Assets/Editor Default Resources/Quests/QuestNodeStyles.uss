.quest-node__extension-container
{
    background-color: #1d1d1e;
    padding: 5px;
}

.quest-node__main-container
{
    background-color: #505050;
}

.quest-node__custom-container
{
    margin-bottom: 5px;
}

.quest-node__textfield > .unity-text-field__input
{
    background-color: #272728;
    border-color: #27292C;
    min-width: 150px;
    max-width: 200px;
    white-space: normal;
    padding: 5px;
}

.quest-node__filename-textfield > .unity-text-field__input
{
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    min-width: 50px;
    padding: 5px;
}

.quest-node__enum-field > .unity-enum-field__input
{
    background-color: #272728;
    border-color: #27292C;
    padding: 5px;
}

.quest-node__integer-field > .unity-integer-field__input
{
    background-color: #272728;
    border-color: #27292C;
    padding: 5px;
}

.quest-node__object-field > .unity-object-field__input
{
    background-color: #272728;
    border-color: #27292C;
}

.quest-node__button
{
    background-color: #2e2e2f;
    border-color: #2e3134;
}

